# Canonical site URL used for metadataBase, canonical tags, OG URLs, sitemap
# and robots. Defaults to Vercel's production domain, then
# https://jaypokharna.vercel.app. Set this when a custom domain goes live.
NEXT_PUBLIC_SITE_URL=

# Search-console verification. Tags render only when these are set.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=

# /exc Excalidraw app storage (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
